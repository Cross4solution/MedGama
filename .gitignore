/.pnp
.pnp.js

# testing
/coverage

# production
/build

# misc
.DS_Store
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Laravel Backend
/backend/vendor
/backend/.env
/backend/database/database.sqlite
/backend/storage/*.key
/backend/bootstrap/cache/*
