next-env.d.ts

# Playwright uçtan uca testler
/test-results/
/playwright-report/
/blob-report/
# Test oturumları: içinde geçerli giriş anahtarı var, depoya girmemeli.
/tests/e2e/.oturum/

# Tarama raporları: üretilen çıktı, depoya girmez.
/tests/e2e/rapor/

# Yerel e2e/MySQL kosusu icin turetilen ortam dosyalari.
# `.env.canli.yedek` CANLI GIZLI ANAHTARLARI tasiyor: asla islenmemeli.
.env.*yedek
.env.e2e
